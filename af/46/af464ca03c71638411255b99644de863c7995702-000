    # FR : jaune vif plein, pas une teinte pale.
    'subtitle_weight': 900,
    'subtitle_color': (0xFF, 0xE6, 0x00, 255),
    'subtitle_size_start': 62,
    'subtitle_max_width_ratio': 0.86,
    'line1_y': 1520,
    'line2_y': 1610,
    # Subtle drop shadow added 2026-09-12 on both the yellow subtitles and the white title pill,
