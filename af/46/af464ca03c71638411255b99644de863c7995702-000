"""Render the animated subtitle and title overlay for a 30 second short, piped straight into ffmpeg.

WHY A PIPE. 900 RGBA frames at 1080x1920 would mean writing and re-reading ~7 GB of PNGs. Streaming
raw frames to ffmpeg's stdin, as a second input, skips that entirely: no intermediate files, no
compression overhead, one process reads what the other writes.

FR : le pipe evite d ecrire puis relire des gigaoctets de PNG intermediaires.
"""
import sys

# Restored 2026-09-12: legacy V4 title kept for comparison.
from PIL import Image, ImageDraw, ImageFilter, ImageFont

# -- PARAMETERS (HDA law: everything tunable lives here) -----------------------------------------
P = {
    'width': 1080,
    'height': 1920,
    'fps': 30,
    'duration': 30.0,
    # Corrected 2026-09-12: "Houdini" stays upright and "Procedural Church" stays italic.
    # FR : "Houdini" reste droit et "Procedural Church" reste en italique.
    'title_font': '/Users/zenray/Library/Fonts/AnthropicSerif-SemiBold.ttf',
    'title_font_italic': '/Users/zenray/Library/Fonts/AnthropicSerif-SemiBoldItalic.ttf',
    # Corrected again: NO forced uppercase anywhere in the title, sentence case throughout.
    # Matthieu: "NON TOUT EN CASSE NORMAL".
    # FR : plus aucune majuscule forcee, casse normale partout.
    'title_text_upright': 'Houdini',
    'title_text_italic': ' Louisiana Bayou',
    'title_size_start': 130,           # the title is sized to the MAXIMUM px that still fits, never cropped
    'title_max_pill_width_ratio': 0.92,
    'title_pill_bg': (255, 255, 255, 255),
    'title_text_color': (0, 0, 0, 255),
    'title_radius_ratio': 0.30,
    'title_pad_x_ratio': 0.55,
    'title_pad_y_ratio': 0.42,
    'title_y_center': 260,
    'subtitle_font': '/Users/zenray/Library/Fonts/InterVariable.ttf',
    # Corrected 2026-09-12: the bottom subtitles are Inter ExtraBold (800), not SemiBold (600).
    # FR : les sous-titres du bas sont en Inter ExtraBold, pas SemiBold.
